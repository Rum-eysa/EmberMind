# EM-109: Geliştirme ortamı (.env.dev)
# Kullanım: cp .env.dev.example .env.dev
APP_ENV=development

# Veritabanı (PostgreSQL — docker compose up db)
DATABASE_URL=postgresql://wildfire_user:wildfire_dev_pass@localhost:5432/wildfire_dev
POSTGRES_DB=wildfire_dev
POSTGRES_USER=wildfire_user
POSTGRES_PASSWORD=wildfire_dev_pass

# Redis
REDIS_URL=redis://localhost:6379/0

# API anahtarları (kendi anahtarlarınızı girin)
FIRMS_API_KEY=
OPENWEATHER_API_KEY=

# Pipeline
FIRMS_SYNC_INTERVAL_MINUTES=10
FWI_SYNC_INTERVAL_MINUTES=1440

# Logging
LOG_LEVEL=DEBUG
