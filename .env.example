# Veritabanı
DATABASE_URL=postgresql://wildfire_user:your_secure_password@db:5432/wildfire_db
DATABASE_USER=wildfire_user
DATABASE_PASSWORD=your_secure_password
POSTGRES_DB=wildfire_db
POSTGRES_USER=wildfire_user
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
FIRMS_API_KEY=your_firms_api_key
# Multi-satellite products (VIIRS + MODIS) merged and deduplicated (EM-012)
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,MODIS_Terra_CorrectedAnomalies,MODIS_Aqua_CorrectedAnomalies
# Legacy single-source fallback (used only when FIRMS_SOURCES is unset)
FIRMS_SOURCE=VIIRS_SNPP_NRT
# minLon,minLat,maxLon,maxLat (default: Turkey)
FIRMS_BBOX=25,35,45,43
FIRMS_DAYS=1
FIRMS_SYNC_INTERVAL_MINUTES=10
FIRMS_CLUSTER_RADIUS_KM=2
# Cross-satellite detections within this window (min) are treated as duplicates
SATELLITE_DEDUP_TIME_WINDOW_MINUTES=180
OPENWEATHER_API_KEY=your_openweather_api_key
# Hava sorgusu önbellek süresi (sn) ve yeniden deneme sayısı
OPENWEATHER_CACHE_TTL_SECONDS=1800
WEATHER_RETRY_COUNT=3
# Fire Weather Index & drought indicator (EM-014)
# Analysis zone edge length in degrees over the pilot region bbox
FWI_ZONE_SIZE_DEG=0.5
# FWI is a daily indicator; recomputed at this interval (minutes)
FWI_SYNC_INTERVAL_MINUTES=1440
# Rothermel yayılım tahmini (EM-015)
# Dakika cinsinden yayılım ufukları (virgülle ayrılır)
SPREAD_HORIZON_MINUTES=30,60,120
# Risk bölgesi poligonu köşe sayısı
SPREAD_POLYGON_VERTICES=36
# Yayılım motoru sürüm etiketi
SPREAD_MODEL_NAME=rothermel_v1
# Yakıt geçişine duyarlı poligon (EM-016; kapalıysa saf eliptik yol)
FUEL_TRANSITION_ENABLED=true
# Otomatik tahmin tetikleme (EM-018)
# Celery periyodik tarama anahtarı (true/false)
SPREAD_AUTO_TRIGGER_ENABLED=true
# Tarama aralığı (dakika)
SPREAD_TRIGGER_INTERVAL_MINUTES=10
# Aynı olay için minimum yeniden çalışma aralığı (dakika, debounce)
SPREAD_TRIGGER_DEBOUNCE_MINUTES=15
# "Anlamlı değişim" eşikleri
SPREAD_TRIGGER_WIND_SPEED_KMH_THRESHOLD=10.0
SPREAD_TRIGGER_WIND_DIR_DEG_THRESHOLD=30.0
SPREAD_TRIGGER_HUMIDITY_PCT_THRESHOLD=10.0
SPREAD_TRIGGER_TEMP_C_THRESHOLD=5.0
# Dinamik otomatik yeniden hesaplama (EM-057)
# Rüzgar / yangın konumu / kapasite değişince planı otomatik yeniden hesapla (true/false)
AUTO_RECOMPUTE_ENABLED=true
# Yeniden hesaplama tarama aralığı (dakika)
AUTO_RECOMPUTE_INTERVAL_MINUTES=5
# Anlamlı konum değişimi eşiği (km, haversine)
AUTO_RECOMPUTE_POSITION_MOVE_KM=1.0
# Anlamlı kapasite değişimi eşiği (bağıl %)
AUTO_RECOMPUTE_CAPACITY_CHANGE_PCT=10.0
# Ölü yakıt nemi modeli (EM-019)
# 1/10/100 saat sınıf nemleri sıcaklık + nemden türetilir (true/false)
FUEL_MOISTURE_MODEL_ENABLED=true
# Sentetik günlük döngü genlikleri (gece sıcaklık düşüşü / nem artışı)
FUEL_MOISTURE_DIURNAL_TEMP_AMPLITUDE_C=8.0
FUEL_MOISTURE_DIURNAL_RH_AMPLITUDE_PCT=25.0
# Şartlandırma penceresi (saat; 48 = iki tam günlük döngü)
FUEL_MOISTURE_CONDITIONING_HOURS=48
# Belirsizlik gösterimi (EM-020)
# Rüzgâr ansambli bozumları: yön ±derece ve hız ±oran (0.15 = %15)
SPREAD_UNCERTAINTY_WIND_DIR_DELTA_DEG=10.0
SPREAD_UNCERTAINTY_WIND_SPEED_FRACTION=0.15
# Kara/deniz maskesi ve doğal engeller (EM-021)
# Su kütleleri poligonları kırpılır, yol/ırmak yavaşlatma katsayısıyla
SPREAD_BARRIERS_ENABLED=true
# Model performans optimizasyonu (EM-022)
# Girdi katmanları önbellek + vektörleştirme; kapalıysa saf skaler yol
SPREAD_PERF_ENABLED=true
# Önbellek tazeleme süresi (sn) ve koordinat kuantum adımları (derece)
SPREAD_PERF_CACHE_TTL_SECONDS=120
SPREAD_PERF_CACHE_GRID_DEG=0.001
# Benchmark'ın değerlendirildiği yeniden hesaplama hedefi (sn)
SPREAD_RECOMPUTE_TARGET_SECONDS=10.0
# Komutan kapasite & risk paneli (EM-073)
# İlk aşım zamanının hesaplandığı FWI eşik değeri
RISK_PANEL_THRESHOLD=30.0
# Operasyonel risk indeksi seviye eşikleri (EM-029): Risk(t)=talep/kapasite
# altındaki üç sınır yapılandırılabilir; sonuncusunun üstü kritiktir
RISK_INDEX_NORMAL_MAX=0.6
RISK_INDEX_CAUTION_MAX=0.9
RISK_INDEX_CRITICAL_NEAR_MAX=1.2
# Eşik aşımı uyarısı (EM-032): risk bir üst seviyeye çıkınca canlı beslemeye
# "alert" yazılır (operatör haritasında görsel+sesli); histerezis tekrarları bastırır
RISK_ALERTS_ENABLED=true
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Uygulamalar
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_min_32_chars
API_BASE_URL=http://localhost:8000
# Demo ortamı veritabanı (DemoConfig; vars. instance/wildfire-demo.db)
DEMO_DATABASE_URL=sqlite:///instance/wildfire-demo.db

USGS_SRTM_BASE_URL=https://api.open-elevation.com/api/v1
TOPOGRAPHY_RESOLUTION_METERS=30
# Topografya okuma önbelleği (sn)
TOPOGRAPHY_CACHE_TTL_SECONDS=86400
# OSM / Overpass yol ağı (EM-009)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
ROAD_NETWORK_SYNC_INTERVAL_MINUTES=720
# Erişim hızı hesabı (km/sa)
ROAD_ACCESS_SPEED_KMH=40
# Maruziyet analizi (EM-023): yerleşim/yol/enerji hatları × tahmin poligonları
# İçe alma bbox alanı üst sınırı (derece^2; pilot bölge ~14) ve tek alımda maksimum öğe sayısı
EXPOSURE_IMPORT_MAX_BBOX_AREA_DEG2=30.0
EXPOSURE_IMPORT_MAX_ASSETS=2000
# Yalnızca bu yerleşim sınıfları (isimliyse) içe alınır
EXPOSURE_IMPORT_PRIORITY_PLACE_CLASSES=city,town,village
# Tehdit analizi kısa ömürlü önbellek (tablo parmak izine göre, sn)
EXPOSURE_CACHE_ENABLED=true
EXPOSURE_CACHE_TTL_SECONDS=60
# Öncelik skoru nüfus normalizasyon referansı (log ölçek)
EXPOSURE_POPULATION_REFERENCE=100000
# Proaktif kaynak konumlandırma (EM-052): olay başına gösterilen en yakın kaynak önerisi sayısı
POSITIONING_MAX_PROPOSALS=5
# Hava kaynakları (helikopter/iha) kuş uçuşu uçar (EM-049): düz çizgi mesafeyi ETA'ya çeviren seyir hızı (km/sa)
POSITIONING_AIR_SPEED_KMH=220
# Kısıt tabanlı optimizasyon (EM-050): menzil (range_km) ve mesai/yakıt (shift_minutes) sınırını
# aşan, kapalı yol nedeniyle ulaşılamayan öneriler üretilmez ve elenme nedeni gösterilir.
# Gece yasağı: gece yetkisi olmayan birim varışı gece penceresine denk gelirse elenir (1/0).
POSITIONING_NIGHT_BAN_ENABLED=1
# Kapasite birimi tanımı ve normalizasyonu (EM-028): kaynak tipi başına varsayılan
# "etkin müdahale kapasitesi" (hektar/saat). Yönetici arayüzden değiştirebilir.
CAPACITY_HA_PER_HOUR_CREW=2.0
CAPACITY_HA_PER_HOUR_HELICOPTER=12.0
CAPACITY_HA_PER_HOUR_UAV=4.0

# EM-034: Kapasite varsayımı denetim kaydı — düzenlenen her gerçek değişiklik
# (eski -> yeni, düzenleyen, zaman) kaydedilir. Yönetim ekranının her isteşte
# geri okuyacağı geçmiş satırı sayısını sınırlandırır.
CAPACITY_AUDIT_DEFAULT_LIMIT=50
CAPACITY_AUDIT_MAX_LIMIT=200
# Zamana bağlı kapasite (EM-033): yoldaki kaynaklar varış ETA'sından itibaren
# kapasite çizelgesine eklenir; kapalıyken çizelge sabit kapasite kullanır (EM-030)
TIME_DEPENDENT_CAPACITY=true
# Dış destek erken tahmini (EM-065): ulusal kapasite yetersiz kalınca istenecek
# takviye birimin varsayılan etkin kapasitesi (ha/saat) ve talebin açık oluşmadan
# kaç dakika önce gönderilmesi gerektiği (varış payı).
EXTERNAL_SUPPORT_UNIT_HA_PER_HOUR=12.0
EXTERNAL_SUPPORT_LEAD_TIME_MINUTES=60
# Rüzgar What-If canlı yeniden hesaplama hedefi (EM-055, sn)
WHATIF_RECOMPUTE_TARGET_SECONDS=10.0
# What-If koşu geçmişi (EM-062): başarılı her koşu yuvarlanan listeye eklenir
WHATIF_HISTORY_ENABLED=true
# Geçmişte tutulan maksimum koşu sayısı (yaşlılar budanır)
WHATIF_HISTORY_LIMIT=10
# Yeniden hesaplama performans bütçesi (EM-060): p95 gecikme hedefi sn;
# aşılınca uyarı + otomatik kaba çözünürlüğe ölçek küçültme
PERF_BUDGET_ENABLED=true
PERF_BUDGET_TARGET_SECONDS=10.0
PERF_BUDGET_WINDOW=50
PERF_BUDGET_MIN_SAMPLES=5
PERF_BUDGET_ALERTS_ENABLED=true
PERF_BUDGET_COARSE_VERTICES=12
PERF_BUDGET_COARSE_HORIZONS=30,120
# Canlı güncelleme / WebSocket (EM-090): olay/tahmin/uyarı akışı
# Anahtar (true/false) ve her bağlantının akışı yoklama aralığı (sn)
LIVE_UPDATES_ENABLED=true
LIVE_POLL_INTERVAL_SECONDS=2.0
# Boşta ölü bağlantıyı tespit için keepalive çerçevesi aralığı (sn; 0=kapalı)
LIVE_HEARTBEAT_SECONDS=15
# Yeniden bağlananda telafi edilecek en fazla kaçırılan güncelleme sayısı
LIVE_MAX_CATCHUP=100
# Veri kalitesi ve tazeliği (EM-010)
DATA_QUALITY_STALE_MULTIPLIER=2
DATA_QUALITY_FAILURE_WARNING_THRESHOLD=3
# Görünüm standardizasyonu (EM-063): zaman UTC saklanır, burada seçilen yerel
# bölgede gösterilir (TR=Europe/Istanbul, GR=Europe/Athens); birimler metriktir;
# koordinat gösterim formatı: decimal (ondalık dereceden) veya dms.
DISPLAY_TIMEZONE=Europe/Istanbul
DISPLAY_COORDINATE_FORMAT=decimal

# Sınır ötesi durum görünümü (EM-066): FireEvent yalnız koordinat tuttuğu için
# her olay bu pilot sınır boylamına göre TR (doğu) veya GR (batı) ülkesine
# atanır. Varsayılan veri paylaşım kapsamı tüm alan gruplarını (fire/risk/
# support) gösterir; bir görünüm ?fields= ile daraltabilir. Ülke bazlı yetki
# politikası EM-070'e bırakılmıştır.
CROSSBORDER_BORDER_LONGITUDE=26.5
CROSSBORDER_SHARED_FIELDS=fire,risk,support

# EM-068: Çok dilli arayüz (E7). Arayüz metinleri i18n kataloğundan gelir;
# TR ve EN tam, EL çekirdek ekranlar. Desteklenen kodlar tr/en/el; bilinmeyen
# red edilir (400). Operatör seçimi yalnız tarayıcıda saklanır (persistence yok).
I18N_DEFAULT_LANGUAGE=tr

# EM-070: Ülke/rol bazlı veri paylaşım politikası (E7). Açık bir (ülke, rol) veya
# ülke-varsayılanı politika satırı yokken karşı ülkeye paylaşılan varsayılan alan
# grupları. country_share_policy tablosu (ek-yazılımlı denetim) bunu anahtar
# bazında ezer.
SHARE_POLICY_DEFAULT_FIELDS=fire,risk,support

# EM-069: Ortak sınır ötesi erken uyarı bildirimi (E7). EM-067 sınır geçiş
# projeksiyonu bu eşiklere ulaştığında karşı ülke koordinasyon birimi önceden
# tanımlı kanaldan uyarılır. Kenar-tetiklemeli (olay+hedef başına tek açık
# bildirim), crossborder_notification tablosuna kalıcı yazılır; _ENABLED
# periyodik taramayı açıp kapatır.
CROSSBORDER_NOTIFY_MIN_LIKELIHOOD=0.4
CROSSBORDER_NOTIFY_WINDOW_MINUTES=120
CROSSBORDER_NOTIFY_ENABLED=true

# EM-071: Dış destek talebi taslağı (E7). EM-065 erken tahmininden (ihtiyaç/
# zaman/konum) otomatik özetlenen talep taslağının varsayılan dili; operatör
# istek başına tr/en/el ile geçersiz kılabilir. Geçersiz/boş değer EM-068
# varsayılanına düşer. Taslak düzenlenebilir ve kopyalanabilir/PDF alınabilir.
SUPPORT_REQUEST_DEFAULT_LANGUAGE=tr

# EM-078: Sessiz bölge güven paneli (Epic E8)
# Aktif bir sessiz bölge, canlı yangın verisinin onu ne kadar çürüttüğüne göre
# puanlanır: sınır kutusu içindeki bir yangın doğrudan çelişkidir, yakındaki bir
# yangın ise güveni PROXIMITY_FAR_KM mesafeye kadar doğrusal olarak aşındırır.
# Kesim noktaları puanı operatörün filtrelediği yüksek/orta/düşük bantlarına ayırır.
SILENT_ZONE_HIGH_CONFIDENCE=0.75
SILENT_ZONE_MODERATE_CONFIDENCE=0.40
SILENT_ZONE_PROXIMITY_FAR_KM=25.0

# EM-079: Panel durumu kataloğu (Epic E8)
# Operatör panellerinin yükleme/boş/hata metinleri ve bağlantı-kesildi bandı
# tek bir deterministik katalogdan gelir; bu yalnızca etiket dilini ayarlar.
UI_STATE_LANGUAGE=tr

# EM-081: Olay zaman çizelgesi (Epic E8)
# Vardiya devri için canlı akış (olay/tahmin/uyarı) + kabul edilen öneri
# denetim kayıtları tek kronolojik akışta birleştirilir. Sayfa boyutunun
# varsayılanı ve üst sınırı burada ayarlanır (okuma zamanı projeksiyonu).
EVENT_TIMELINE_DEFAULT_LIMIT=50
EVENT_TIMELINE_MAX_LIMIT=200

# EM-082: Çoklu yangın yönetimi (Epic E8)
# Eş zamanlı aktif yangın envanteri ve kaynak paylaşım çakışmaları (öksüz
# konuşlama / birden çok yangına kaynak veren üs / eksik konuşlanmış acil olay)
# okuma zamanı derlenir. Bu, envanterin kaç olaya kadar taranacağını sınırlar.
MULTI_FIRE_MAX_EVENTS=50

# EM-083: Salt okunur belediye görünümü (Epic E8)
# Belediye yöneticisine gösterilen sadeleştirilmiş, yalnızca izleme amaçlı
# bölge. Koordinat kutusu (varsayılan: pilot bölge) ve azami listelenecek aktif
# yangın sayısı burada belirlenir; operatör karar kontrolleri gizlenir.
MUNICIPALITY_VIEW_REGION_NAME=TR-GR Coastal Wildfire Pilot Region
MUNICIPALITY_VIEW_MIN_LAT=36.0
MUNICIPALITY_VIEW_MAX_LAT=39.5
MUNICIPALITY_VIEW_MIN_LON=26.0
MUNICIPALITY_VIEW_MAX_LON=30.0
MUNICIPALITY_VIEW_MAX_FIRES=100

# EM-086: Bildirim merkezi ve sesli uyarı ayarları (Epic E8)
# Canlı akıştaki (EM-032) risk uyarıları okundu/onaylandı durumuyla izlenir;
# kritik bant onaylanana kadar panelde sabit kalır. penceredeki azami uyarı
# sayısı, sesli alarmın varsayılan durumu ve çalacağı en düşük risk bandı
# (normal < dikkat < kritik-yakin < kritik) burada belirlenir.
NOTIFICATION_MAX_ALERTS=100
NOTIFICATION_SOUND_ENABLED=true
NOTIFICATION_SOUND_MIN_LEVEL=dikkat

# EM-087: Tek sayfalık durum raporu (SITREP) dışa aktarımı (Epic E8)
# Rapor aktif yangın, yayılım tahmini, risk indeksi ve konuşlanma önerilerini
# tek sayfada derler; sentetik veri rozeti ve zaman damgası taşır. Bildirime
# giren azami yangın sayısı ve en sıcak olay için listelenecek azami öneri sayısı.
SITREP_MAX_FIRES=20
SITREP_RECOMMENDATION_LIMIT=5

# EM-088: Kaydedilmiş operatör tercih profili (Epic E8)
# Dil (I18N_DEFAULT_LANGUAGE), saat dilimi / koordinat biçimi (DISPLAY_*)
# ayarlarından miras alınır; yalnız arayüz temasının varsayılanı burada
# belirlenir. Silinmemiş bir profil olmadığında panel bu varsayılanları gösterir.
UI_DEFAULT_THEME=dark

# EM-089: Vardiya devri notları ve tek tık devir özeti (Epic E8)
# Operatör olaya serbest metin not ekler; notlar olay zaman çizelgesiyle
# (EM-081) birleştirilip tek tık vardiya devri özetinde gösterilir. Yalnızca
# event_notes kalıcıdır; özet okuma zamanıdır. Aşağıdaki azami not sayısı,
# not listesi ve devir özeti akışının çekirdeğindeki pencereyi sınırlar.
SHIFT_HANDOVER_MAX_NOTES=100

# EM-094: Olay ve uyarı webhook'ları (Epic E9)
# Bütünleştirici, olay/uyarıları canlı akışı (EM-090) kuyruklamak yerine anında
# dış bir uç noktaya push ister. Her abonelik URL + olay tipleri + HMAC-SHA256
# imza gizli anahtarı taşır; başarısız teslim sınırlı üstel geri çekilme ile
# yeniden denenir ve her deneme kalıcı teslim geçmişine yazılır. Azami abonelik,
# azami teslim, azami deneme bütçesi ve taban geri çekilme saniyesi.
WEBHOOK_MAX_SUBSCRIPTIONS=20
WEBHOOK_MAX_DELIVERIES=100
WEBHOOK_MAX_RETRIES=3
WEBHOOK_BACKOFF_SECONDS=30

# EM-096: Birlesik denetim kaydi (Epic E10)
# Yonetici, hangi alt sistemden gelirse gelsin kimin hangi karari/degisikligi
# ne zaman verdigini tek, degismez bir defterde gormek ister. Kayit basina alan
# (domain) + eylem (action) + ozne + aktor + eski/yeni deger ani goruntusu
# tutulur. Servis yuzeyinde guncelleme/silme yoktur; defter yalniz eklenendir
# ("kayitlar silinemez"). Asagidaki sinirlar bir istekte okunacak azami satir
# sayisini belirler.
AUDIT_DEFAULT_LIMIT=50
AUDIT_MAX_LIMIT=500

# EM-035: Bolge bazli iletisim sinyali baz cizgisi (Epic E4)
# Sessiz bolge anomalisinin anlam kazanmasi icin once "normal" ogrenilir:
# her izleme hucresi icin kayan baz cizgi (ortalama/yayilim/medyan) ve son
# okumanin z-skoru okuma zamaninda hesaplanir (kalicilik: none). Pencere gun
# sayisi, hucre izgara boyutu (satir x sutun, azami hucre ile sinirli),
# sessizlik esigi z-skoru ve pilot varsayilan sinyal kaynagi.
SIGNAL_BASELINE_WINDOW_DAYS=30
SIGNAL_BASELINE_CELL_ROWS=4
SIGNAL_BASELINE_CELL_COLS=5
SIGNAL_BASELINE_MAX_CELLS=60
SIGNAL_BASELINE_SENSITIVITY_Z=1.5
SIGNAL_BASELINE_DEFAULT_SOURCE=synthetic_communication
# Hucre izgarasinin oturtuldugu pilot kutusu (config/pilot_region.json ile ayni)
SIGNAL_PILOT_MIN_LAT=36.0
SIGNAL_PILOT_MAX_LAT=39.5
SIGNAL_PILOT_MIN_LON=26.0
SIGNAL_PILOT_MAX_LON=30.0

# EM-037: yuksek oncelikli sessiz bolge risk kesisimi (Epic E4)
# Sessizlik guveni (EM-078) ile aktif yanginlarin yayilim tahmin poligonlarinin
# (EM-015) bolge kutusunu kapsama orani okuma zamaninda carpilir (kalicilik:
# none). kapsama_alti: "kesisti" sayilmak icin bolge alaninin en az bu orani
# yayilmali; guven_alti: bolgenin "gercekten sessiz" sayilma tabani; taramada
# incelenecek azami tahmin satiri ve tek istekte donecek azami bolge sayisi.
SILENT_REGION_RISK_MIN_COVERAGE=0.05
SILENT_REGION_RISK_MIN_CONFIDENCE=0.5
SILENT_REGION_RISK_MAX_FORECASTS=200
SILENT_REGION_RISK_MAX_LIMIT=200

# EM-038: yanlis alarm onleme - sessiz bolge guven etiketi (Epic E4)
# EM-035 hucre baz cizgisi yeniden kullanilarak sessiz adaylar yapisal kapsama
# gucune ve ani dusus derecesine gore dusuk/orta/yuksek guvenle etiketlenir
# (kalicilik: none). coverage_signal_alti: baz ortalamasi bunun altindaysa
# kapsama "zayif" sayilir (yanlis alarm -> dusuk guven); min_gozlem: guvenilir
# baz icin gereken asgari gozlem sayisi; ani_dusus_z: z bunun altindaysa (-)
# dusus "belirgin" -> yuksek guven; azami_limit: tek istekte donecek azami aday.
FALSE_ALARM_MIN_COVERAGE_SIGNAL=100.0
FALSE_ALARM_MIN_OBSERVATIONS=7
FALSE_ALARM_STRONG_DROP_Z=2.5
FALSE_ALARM_MAX_LIMIT=200

# EM-042 sessiz bolge performans olcumu - sentetik senaryoda TPR/FPR/gecikme (Epic E4)
# Gercek etiketli katalog olmadigindan ground-truth senaryoya deterministik enjekte
# edilir ve EM-035 algilayicisi gun gun yeniden calistirilir (kalicilik: none).
# ufuk_gun: degerlendirme penceresi; baz_pencere_gun: her gun icin ogrenilen gecmis;
# hassasiyet_z: sessizlik esigi (z <= -bu); enjekte_orani: hucrelerin sessiz epizot
# alma olasiligi; kesinti_gun: epizot uzunlugu; kesinti_derinligi: sessiz gunde sinyal
# normalin bu katina duser; azami_gecikme_gun: uyari gecikmesi icin arama ufk.
SILENT_DETECTION_HORIZON_DAYS=30
SILENT_DETECTION_BASELINE_WINDOW_DAYS=14
SILENT_DETECTION_SENSITIVITY_Z=1.5
SILENT_DETECTION_ONSET_RATE=0.4
SILENT_DETECTION_OUTAGE_DAYS=3
SILENT_DETECTION_OUTAGE_DEPTH=0.05
SILENT_DETECTION_MAX_LATENCY_DAYS=5

# Email (Uyarılar için)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
