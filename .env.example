# Veritabanı
DATABASE_URL=postgresql://wildfire_user:your_secure_password@db:5432/wildfire_db
DATABASE_USER=wildfire_user
DATABASE_PASSWORD=your_secure_password
POSTGRES_DB=wildfire_db
POSTGRES_USER=wildfire_user
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
FIRMS_API_KEY=your_firms_api_key
# Multi-satellite products (VIIRS + MODIS) merged and deduplicated (EM-012)
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,MODIS_Terra_CorrectedAnomalies,MODIS_Aqua_CorrectedAnomalies
# Legacy single-source fallback (used only when FIRMS_SOURCES is unset)
FIRMS_SOURCE=VIIRS_SNPP_NRT
# minLon,minLat,maxLon,maxLat (default: Turkey)
FIRMS_BBOX=25,35,45,43
FIRMS_DAYS=1
FIRMS_SYNC_INTERVAL_MINUTES=10
FIRMS_CLUSTER_RADIUS_KM=2
# Cross-satellite detections within this window (min) are treated as duplicates
SATELLITE_DEDUP_TIME_WINDOW_MINUTES=180
OPENWEATHER_API_KEY=your_openweather_api_key
# Hava sorgusu önbellek süresi (sn) ve yeniden deneme sayısı
OPENWEATHER_CACHE_TTL_SECONDS=1800
WEATHER_RETRY_COUNT=3
# Fire Weather Index & drought indicator (EM-014)
# Analysis zone edge length in degrees over the pilot region bbox
FWI_ZONE_SIZE_DEG=0.5
# FWI is a daily indicator; recomputed at this interval (minutes)
FWI_SYNC_INTERVAL_MINUTES=1440
# Rothermel yayılım tahmini (EM-015)
# Dakika cinsinden yayılım ufukları (virgülle ayrılır)
SPREAD_HORIZON_MINUTES=30,60,120
# Risk bölgesi poligonu köşe sayısı
SPREAD_POLYGON_VERTICES=36
# Yayılım motoru sürüm etiketi
SPREAD_MODEL_NAME=rothermel_v1
# Yakıt geçişine duyarlı poligon (EM-016; kapalıysa saf eliptik yol)
FUEL_TRANSITION_ENABLED=true
# Otomatik tahmin tetikleme (EM-018)
# Celery periyodik tarama anahtarı (true/false)
SPREAD_AUTO_TRIGGER_ENABLED=true
# Tarama aralığı (dakika)
SPREAD_TRIGGER_INTERVAL_MINUTES=10
# Aynı olay için minimum yeniden çalışma aralığı (dakika, debounce)
SPREAD_TRIGGER_DEBOUNCE_MINUTES=15
# "Anlamlı değişim" eşikleri
SPREAD_TRIGGER_WIND_SPEED_KMH_THRESHOLD=10.0
SPREAD_TRIGGER_WIND_DIR_DEG_THRESHOLD=30.0
SPREAD_TRIGGER_HUMIDITY_PCT_THRESHOLD=10.0
SPREAD_TRIGGER_TEMP_C_THRESHOLD=5.0
# Ölü yakıt nemi modeli (EM-019)
# 1/10/100 saat sınıf nemleri sıcaklık + nemden türetilir (true/false)
FUEL_MOISTURE_MODEL_ENABLED=true
# Sentetik günlük döngü genlikleri (gece sıcaklık düşüşü / nem artışı)
FUEL_MOISTURE_DIURNAL_TEMP_AMPLITUDE_C=8.0
FUEL_MOISTURE_DIURNAL_RH_AMPLITUDE_PCT=25.0
# Şartlandırma penceresi (saat; 48 = iki tam günlük döngü)
FUEL_MOISTURE_CONDITIONING_HOURS=48
# Belirsizlik gösterimi (EM-020)
# Rüzgâr ansambli bozumları: yön ±derece ve hız ±oran (0.15 = %15)
SPREAD_UNCERTAINTY_WIND_DIR_DELTA_DEG=10.0
SPREAD_UNCERTAINTY_WIND_SPEED_FRACTION=0.15
# Kara/deniz maskesi ve doğal engeller (EM-021)
# Su kütleleri poligonları kırpılır, yol/ırmak yavaşlatma katsayısıyla
SPREAD_BARRIERS_ENABLED=true
# Model performans optimizasyonu (EM-022)
# Girdi katmanları önbellek + vektörleştirme; kapalıysa saf skaler yol
SPREAD_PERF_ENABLED=true
# Önbellek tazeleme süresi (sn) ve koordinat kuantum adımları (derece)
SPREAD_PERF_CACHE_TTL_SECONDS=120
SPREAD_PERF_CACHE_GRID_DEG=0.001
# Benchmark'ın değerlendirildiği yeniden hesaplama hedefi (sn)
SPREAD_RECOMPUTE_TARGET_SECONDS=10.0
# Komutan kapasite & risk paneli (EM-073)
# İlk aşım zamanının hesaplandığı FWI eşik değeri
RISK_PANEL_THRESHOLD=30.0
# Operasyonel risk indeksi seviye eşikleri (EM-029): Risk(t)=talep/kapasite
# altındaki üç sınır yapılandırılabilir; sonuncusunun üstü kritiktir
RISK_INDEX_NORMAL_MAX=0.6
RISK_INDEX_CAUTION_MAX=0.9
RISK_INDEX_CRITICAL_NEAR_MAX=1.2
# Eşik aşımı uyarısı (EM-032): risk bir üst seviyeye çıkınca canlı beslemeye
# "alert" yazılır (operatör haritasında görsel+sesli); histerezis tekrarları bastırır
RISK_ALERTS_ENABLED=true
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Uygulamalar
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_min_32_chars
API_BASE_URL=http://localhost:8000
# Demo ortamı veritabanı (DemoConfig; vars. instance/wildfire-demo.db)
DEMO_DATABASE_URL=sqlite:///instance/wildfire-demo.db

USGS_SRTM_BASE_URL=https://api.open-elevation.com/api/v1
TOPOGRAPHY_RESOLUTION_METERS=30
# Topografya okuma önbelleği (sn)
TOPOGRAPHY_CACHE_TTL_SECONDS=86400
# OSM / Overpass yol ağı (EM-009)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
ROAD_NETWORK_SYNC_INTERVAL_MINUTES=720
# Erişim hızı hesabı (km/sa)
ROAD_ACCESS_SPEED_KMH=40
# Maruziyet analizi (EM-023): yerleşim/yol/enerji hatları × tahmin poligonları
# İçe alma bbox alanı üst sınırı (derece^2; pilot bölge ~14) ve tek alımda maksimum öğe sayısı
EXPOSURE_IMPORT_MAX_BBOX_AREA_DEG2=30.0
EXPOSURE_IMPORT_MAX_ASSETS=2000
# Yalnızca bu yerleşim sınıfları (isimliyse) içe alınır
EXPOSURE_IMPORT_PRIORITY_PLACE_CLASSES=city,town,village
# Tehdit analizi kısa ömürlü önbellek (tablo parmak izine göre, sn)
EXPOSURE_CACHE_ENABLED=true
EXPOSURE_CACHE_TTL_SECONDS=60
# Öncelik skoru nüfus normalizasyon referansı (log ölçek)
EXPOSURE_POPULATION_REFERENCE=100000
# Proaktif kaynak konumlandırma (EM-052): olay başına gösterilen en yakın kaynak önerisi sayısı
POSITIONING_MAX_PROPOSALS=5
# Kapasite birimi tanımı ve normalizasyonu (EM-028): kaynak tipi başına varsayılan
# "etkin müdahale kapasitesi" (hektar/saat). Yönetici arayüzden değiştirebilir.
CAPACITY_HA_PER_HOUR_CREW=2.0
CAPACITY_HA_PER_HOUR_HELICOPTER=12.0
CAPACITY_HA_PER_HOUR_UAV=4.0
# Rüzgar What-If canlı yeniden hesaplama hedefi (EM-055, sn)
WHATIF_RECOMPUTE_TARGET_SECONDS=10.0
# Canlı güncelleme / WebSocket (EM-090): olay/tahmin/uyarı akışı
# Anahtar (true/false) ve her bağlantının akışı yoklama aralığı (sn)
LIVE_UPDATES_ENABLED=true
LIVE_POLL_INTERVAL_SECONDS=2.0
# Boşta ölü bağlantıyı tespit için keepalive çerçevesi aralığı (sn; 0=kapalı)
LIVE_HEARTBEAT_SECONDS=15
# Yeniden bağlananda telafi edilecek en fazla kaçırılan güncelleme sayısı
LIVE_MAX_CATCHUP=100
# Veri kalitesi ve tazeliği (EM-010)
DATA_QUALITY_STALE_MULTIPLIER=2
DATA_QUALITY_FAILURE_WARNING_THRESHOLD=3

# Email (Uyarılar için)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@example.com

# Loglama
LOG_LEVEL=INFO
SENTRY_DSN=https://your_sentry_dsn

# Timezone
TZ=Europe/Istanbul
