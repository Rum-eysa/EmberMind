# EM-109: Demo / sunum ortamı (.env.demo)
# Harici API anahtarı GEREKTİRMEZ — SQLite + sentetik veriyle çalışır.
# Kullanım: cp .env.demo.example .env.demo
APP_ENV=demo

# SQLite (kurulum gerektirmez)
DATABASE_URL=sqlite:///instance/wildfire-demo.db

# Sentetik senaryo (EM-104) — demo başlangıcında otomatik üretilir
DEMO_SYNTHETIC_SEED=7
DEMO_SYNTHETIC_PRESET=standart

# Boş anahtarlar — dış API'ler devre dışı
FIRMS_API_KEY=
OPENWEATHER_API_KEY=

# Logging
LOG_LEVEL=INFO
